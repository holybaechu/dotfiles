$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - name: WindowedGames
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\Graphics.ps1" -Operation Get -Context User
      testScript: |
        & "${WinGetConfigRoot}\scripts\Graphics.ps1" -Operation Test -Context User
      setScript: |
        & "${WinGetConfigRoot}\scripts\Graphics.ps1" -Operation Set -Context User
  - name: HardwareGpuScheduling
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\Graphics.ps1" -Operation Get -Context Machine
      testScript: |
        & "${WinGetConfigRoot}\scripts\Graphics.ps1" -Operation Test -Context Machine
      setScript: |
        & "${WinGetConfigRoot}\scripts\Graphics.ps1" -Operation Set -Context Machine
    metadata:
      winget:
        securityContext: elevated
