$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - name: SshAgent
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        Get-Service -Name ssh-agent | Select-Object Status, StartType
      testScript: |
        $agent = Get-Service -Name ssh-agent
        $agent.Status -eq 'Running' -and $agent.StartType -eq 'Automatic'
      setScript: |
        $ErrorActionPreference = 'Stop'
        Set-Service -Name ssh-agent -StartupType Automatic
        Start-Service -Name ssh-agent
    metadata:
      winget:
        securityContext: elevated

  - name: ExplorerPreferences
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      input:
        hideDesktopIcons: true
        showHiddenFiles: true
        showFileExtensions: true
      getScript: |
        param($settings)
        & "${WinGetConfigRoot}\scripts\ExplorerPreferences.ps1" -Operation Get
      testScript: |
        param($settings)
        $current = & "${WinGetConfigRoot}\scripts\ExplorerPreferences.ps1" -Operation Get
        $current.HideDesktopIcons -eq $settings.hideDesktopIcons -and
          $current.ShowHiddenFiles -eq $settings.showHiddenFiles -and
          $current.ShowFileExtensions -eq $settings.showFileExtensions
      setScript: |
        param($settings)
        & "${WinGetConfigRoot}\scripts\ExplorerPreferences.ps1" -Operation Set -HideDesktopIcons $settings.hideDesktopIcons -ShowHiddenFiles $settings.showHiddenFiles -ShowFileExtensions $settings.showFileExtensions

  - name: KomorebiConfigHome
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        $value = [Environment]::GetEnvironmentVariable('KOMOREBI_CONFIG_HOME', 'User')
        $value
      testScript: |
        $expected = Join-Path $env:USERPROFILE '.config\komorebi'
        [Environment]::GetEnvironmentVariable('KOMOREBI_CONFIG_HOME', 'User') -eq $expected
      setScript: |
        $expected = Join-Path $env:USERPROFILE '.config\komorebi'
        [Environment]::SetEnvironmentVariable('KOMOREBI_CONFIG_HOME', $expected, 'User')

  - name: WindowShadows
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      input:
        enabled: false
      getScript: |
        param($settings)
        & "${WinGetConfigRoot}\scripts\WindowShadows.ps1" -Operation Get
      testScript: |
        param($settings)
        (& "${WinGetConfigRoot}\scripts\WindowShadows.ps1" -Operation Get) -eq $settings.enabled
      setScript: |
        param($settings)
        & "${WinGetConfigRoot}\scripts\WindowShadows.ps1" -Operation Set -Enabled $settings.enabled

  - name: TaskbarAutoHide
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      input:
        enabled: true
      getScript: |
        param($settings)
        & "${WinGetConfigRoot}\scripts\TaskbarAutoHide.ps1" -Operation Get
      testScript: |
        param($settings)
        (& "${WinGetConfigRoot}\scripts\TaskbarAutoHide.ps1" -Operation Get) -eq $settings.enabled
      setScript: |
        param($settings)
        & "${WinGetConfigRoot}\scripts\TaskbarAutoHide.ps1" -Operation Set -Enabled $settings.enabled
