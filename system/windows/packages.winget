$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

# These need Windows installation or registration; portable tools live in mise.
resources:
  - name: Aside
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\Aside.ps1" -Operation Get
      testScript: |
        & "${WinGetConfigRoot}\scripts\Aside.ps1" -Operation Test
      setScript: |
        & "${WinGetConfigRoot}\scripts\Aside.ps1" -Operation Set
    metadata:
      winget:
        securityContext: elevated

  - name: OnePassword
    type: Microsoft.WinGet/Package
    properties:
      id: AgileBits.1Password
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: OnePasswordAsideExtension
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\BrowserExtension.ps1" -Operation Get -Extension 1Password
      testScript: |
        & "${WinGetConfigRoot}\scripts\BrowserExtension.ps1" -Operation Test -Extension 1Password
      setScript: |
        & "${WinGetConfigRoot}\scripts\BrowserExtension.ps1" -Operation Set -Extension 1Password
    metadata:
      winget:
        securityContext: elevated

  - name: UBlockOriginLiteAsideExtension
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\BrowserExtension.ps1" -Operation Get -Extension uBlockOriginLite
      testScript: |
        & "${WinGetConfigRoot}\scripts\BrowserExtension.ps1" -Operation Test -Extension uBlockOriginLite
      setScript: |
        & "${WinGetConfigRoot}\scripts\BrowserExtension.ps1" -Operation Set -Extension uBlockOriginLite
    metadata:
      winget:
        securityContext: elevated

  - name: FlowLauncher
    type: Microsoft.WinGet/Package
    properties:
      id: Flow-Launcher.Flow-Launcher
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: Nalgaeset
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\Nalgaeset.ps1" -Operation Get
      testScript: |
        & "${WinGetConfigRoot}\scripts\Nalgaeset.ps1" -Operation Test
      setScript: |
        & "${WinGetConfigRoot}\scripts\Nalgaeset.ps1" -Operation Set
    metadata:
      winget:
        securityContext: elevated

  - name: ShareX
    type: Microsoft.WinGet/Package
    properties:
      id: ShareX.ShareX
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: WindowsTerminal
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.WindowsTerminal
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: JetBrainsMonoNerdFont
    type: Microsoft.WinGet/Package
    properties:
      id: DEVCOM.JetBrainsMonoNerdFont
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated
