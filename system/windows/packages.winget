$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - name: OnePassword
    type: Microsoft.WinGet/Package
    properties:
      id: AgileBits.1Password
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: Everything
    type: Microsoft.WinGet/Package
    properties:
      id: voidtools.Everything
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: WindowsTerminal
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.WindowsTerminal
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: PowerShell
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.PowerShell
      source: winget
      useLatest: true
      acceptAgreements: true

  - name: JetBrainsMonoNerdFont
    type: Microsoft.WinGet/Package
    properties:
      id: DEVCOM.JetBrainsMonoNerdFont
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Starship
    type: Microsoft.WinGet/Package
    properties:
      id: Starship.Starship
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Fastfetch
    type: Microsoft.WinGet/Package
    properties:
      id: Fastfetch-cli.Fastfetch
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: Neovim
    type: Microsoft.WinGet/Package
    properties:
      id: Neovim.Neovim
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Ripgrep
    type: Microsoft.WinGet/Package
    properties:
      id: BurntSushi.ripgrep.MSVC
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: TreeSitterCli
    type: Microsoft.WinGet/Package
    properties:
      id: tree-sitter.tree-sitter-cli
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: LlvmMingw
    type: Microsoft.WinGet/Package
    properties:
      id: MartinStorsjo.LLVM-MinGW.UCRT
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: Bandizip
    type: Microsoft.WinGet/Package
    properties:
      id: Bandisoft.Bandizip
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Komorebi
    type: Microsoft.WinGet/Package
    properties:
      id: LGUG2Z.komorebi
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Whkd
    type: Microsoft.WinGet/Package
    properties:
      id: LGUG2Z.whkd
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Git
    type: Microsoft.WinGet/Package
    properties:
      id: Git.Git
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: GitHubCli
    type: Microsoft.WinGet/Package
    properties:
      id: GitHub.cli
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Uv
    type: Microsoft.WinGet/Package
    properties:
      id: astral-sh.uv
      source: winget
      useLatest: false
      acceptAgreements: true
