$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - name: AsideBrowser
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\AsideBrowser.ps1" -Operation Get
      testScript: |
        & "${WinGetConfigRoot}\scripts\AsideBrowser.ps1" -Operation Test
      setScript: |
        & "${WinGetConfigRoot}\scripts\AsideBrowser.ps1" -Operation Set
    metadata:
      winget:
        securityContext: elevated

  - name: HeliumBrowser
    type: Microsoft.WinGet/Package
    properties:
      id: ImputNet.Helium
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: PotPlayer
    type: Microsoft.WinGet/Package
    properties:
      id: Daum.PotPlayer
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: OnePassword
    type: Microsoft.WinGet/Package
    properties:
      id: AgileBits.1Password
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: YubicoAuthenticator
    type: Microsoft.WinGet/Package
    properties:
      id: Yubico.Authenticator
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Everything
    type: Microsoft.WinGet/Package
    properties:
      id: voidtools.Everything
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: WindowsTerminal
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.WindowsTerminal
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: PowerShell
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.PowerShell
      source: winget
      useLatest: true
      acceptAgreements: true

  - name: JetBrainsMonoNerdFont
    type: Microsoft.WinGet/Package
    properties:
      id: DEVCOM.JetBrainsMonoNerdFont
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Starship
    type: Microsoft.WinGet/Package
    properties:
      id: Starship.Starship
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Fastfetch
    type: Microsoft.WinGet/Package
    properties:
      id: Fastfetch-cli.Fastfetch
      source: winget
      useLatest: false
      acceptAgreements: true

  - name: Komorebi
    type: Microsoft.WinGet/Package
    properties:
      id: LGUG2Z.komorebi
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Whkd
    type: Microsoft.WinGet/Package
    properties:
      id: LGUG2Z.whkd
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Git
    type: Microsoft.WinGet/Package
    properties:
      id: Git.Git
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: GitHubCli
    type: Microsoft.WinGet/Package
    properties:
      id: GitHub.cli
      source: winget
      useLatest: false
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Uv
    type: Microsoft.WinGet/Package
    properties:
      id: astral-sh.uv
      source: winget
      useLatest: false
      acceptAgreements: true
