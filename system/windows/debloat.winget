$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3

resources:
  - name: RemoveUnwantedStoreApps
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\Debloat.ps1" -Operation Get -AppType Store
      testScript: |
        & "${WinGetConfigRoot}\scripts\Debloat.ps1" -Operation Test -AppType Store
      setScript: |
        & "${WinGetConfigRoot}\scripts\Debloat.ps1" -Operation Set -AppType Store
    metadata:
      winget:
        securityContext: elevated

  - name: RemoveUnwantedDesktopApps
    type: Microsoft.DSC.Transitional/PowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\Debloat.ps1" -Operation Get -AppType Desktop
      testScript: |
        & "${WinGetConfigRoot}\scripts\Debloat.ps1" -Operation Test -AppType Desktop
      setScript: |
        & "${WinGetConfigRoot}\scripts\Debloat.ps1" -Operation Set -AppType Desktop

  - name: RemoveOptionalComponents
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        & "${WinGetConfigRoot}\scripts\RemoveOptionalComponents.ps1" -Operation Get
      testScript: |
        & "${WinGetConfigRoot}\scripts\RemoveOptionalComponents.ps1" -Operation Test
      setScript: |
        & "${WinGetConfigRoot}\scripts\RemoveOptionalComponents.ps1" -Operation Set
    metadata:
      winget:
        securityContext: elevated
