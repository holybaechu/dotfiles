{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
  "display": { "showErrors": false },
  "logo": {
    "type": "small",
    "padding": {
      "right": 2
    }
  },
  "modules": [
    "os",
    "shell",
    "uptime",
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
    // Use the memory-only config to avoid recursively querying the other OS.
    {
      "type": "command",
      "key": "Memory (Windows)",
      "text": "fastfetch.exe --config memory-only.jsonc"
    },
{{- end }}
    "memory",
{{- if eq .chezmoi.os "windows" }}
{{- $wslMemoryScript := joinPath .chezmoi.homeDir ".config" "fastfetch" "wsl-memory.ps1" }}
    // No output (including the label) when Arch is stopped or the query fails.
    {
      "type": "command",
      "key": "Memory (WSL)",
      "shell": "powershell.exe",
      "param": "-NoProfile",
      "text": {{ printf "& '%s'" $wslMemoryScript | toJson }}
    }
{{- end }}
  ]
}
