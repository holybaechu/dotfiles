{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
{{- if eq .chezmoi.os "windows" }}
  "general": { "processingTimeout": 5000 },
{{- end }}
  "display": {
    "showErrors": false,
    "color": { "keys": "#7cab3d", "title": "#bfdc96", "output": "#f0f3e7", "separator": "#aab69e" }
  },
  "logo": {
    "type": "small",
    "color": { "1": "#7cab3d", "2": "#7cab3d", "3": "#7cab3d", "4": "#7cab3d", "5": "#7cab3d", "6": "#7cab3d", "7": "#7cab3d", "8": "#7cab3d", "9": "#7cab3d" },
    "padding": {
      "right": 2
    }
  },
  "modules": [
    "os",
    "shell",
    "uptime",
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
    // Use the memory-only config to avoid recursively querying the other OS.
    {
      "type": "command",
      "key": "Memory (Windows)",
      "text": "fastfetch.exe --config memory-only.jsonc"
    },
{{- end }}
    "memory",
{{- if eq .chezmoi.os "windows" }}
{{- $wslMemoryScript := joinPath .chezmoi.homeDir ".config" "fastfetch" "wsl-memory.ps1" }}
    // No output (including the label) when Arch is stopped or the query fails.
    {
      "type": "command",
      "key": "Memory (WSL)",
      // Invoke PowerShell directly: cmd.exe misreads Fastfetch's escaped quotes.
      "shell": "pwsh.exe",
      "param": "-NoProfile",
      "text": {{ $wslMemoryScript | toJson }}
    }
{{- end }}
  ]
}
