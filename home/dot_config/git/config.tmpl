# Shared Git defaults. Keep per-machine overrides in ~/.gitconfig.
[user]
    name = holybaechu
    email = holybaechu@gmail.com
    signingkey = {{ include "dot_config/git/github.pub" | trim | quote }}
[gpg]
    format = ssh
[gpg "ssh"]
{{ if eq .chezmoi.os "windows" }}
    program = {{ joinPath .chezmoi.homeDir "AppData" "Local" "Microsoft" "WindowsApps" "op-ssh-sign.exe" | replace "\\" "/" | quote }}
{{ else }}
{{- /* Authentication is completed after bootstrap; resolve on PATH at commit time if unavailable now. */}}
    program = {{ lookPath "op-ssh-sign-wsl.exe" | default "op-ssh-sign-wsl.exe" | quote }}
{{ end }}
    allowedSignersFile = ~/.config/git/allowed_signers
[commit]
    gpgSign = true
[tag]
    gpgSign = true
{{ if eq .chezmoi.os "windows" }}
[core]
    sshCommand = {{ joinPath (env "WINDIR") "System32" "OpenSSH" "ssh.exe" | replace "\\" "/" | quote }}
{{ else }}
[core]
    sshCommand = /mnt/c/Windows/System32/OpenSSH/ssh.exe
{{ end }}
