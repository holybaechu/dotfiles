# Git defaults. Keep per-machine overrides in ~/.gitconfig.
[user]
    name = holybaechu
    email = holybaechu@gmail.com
    signingkey = {{ include "dot_config/git/github.pub" | trim | quote }}
[gpg]
    format = ssh
[gpg "ssh"]
    program = /opt/1Password/op-ssh-sign
    allowedSignersFile = ~/.config/git/allowed_signers
[commit]
    gpgSign = true
[tag]
    gpgSign = true
