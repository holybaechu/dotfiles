{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" -}}
{{- $settings := $original | fromJson -}}
{{- $before := $settings | toJson -}}
{{- $settings = setValueAtPath "InterrModifier" "LWin" $settings -}}
{{- $settings = setValueAtPath "DoubleTap" false $settings -}}
{{- if eq ($settings | toJson) $before -}}
{{- $original -}}
{{- else -}}
{{- $settings | toPrettyJson -}}
{{- end -}}
