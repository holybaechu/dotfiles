{{- /* chezmoi:modify-template */ -}}
{{- $settings := .chezmoi.stdin | default "{}" | fromJsonc -}}
{{- $wslGuid := "{2daa9215-ee59-401c-b5d2-77bb27f873d0}" -}}
{{- $powerShellGuid := "{773a475f-cc7c-4bf6-a0a4-987f2adcb069}" -}}
{{- $schemeName := "Canopy" -}}

{{- /* Match home/dot_config/nvim/colors/canopy.lua; preserve unrelated schemes. */ -}}
{{- $scheme := dict
    "name" $schemeName
    "background" "#11160f" "foreground" "#f0f3e7"
    "cursorColor" "#7cab3d" "selectionBackground" "#3c502b"
    "black" "#11160f" "red" "#eea99a" "green" "#bfdc96" "yellow" "#ebc98a"
    "blue" "#aecddd" "purple" "#cfb9dd" "cyan" "#9bd1bd" "white" "#aab69e"
    "brightBlack" "#849575" "brightRed" "#eea99a" "brightGreen" "#d0e7b2" "brightYellow" "#ebc98a"
    "brightBlue" "#aecddd" "brightPurple" "#cfb9dd" "brightCyan" "#9bd1bd" "brightWhite" "#f0f3e7"
-}}
{{- $schemes := list -}}
{{- range (get $settings "schemes" | default (list)) -}}
    {{- if ne (get . "name") $schemeName -}}
        {{- $schemes = append $schemes . -}}
    {{- end -}}
{{- end -}}
{{- $settings = setValueAtPath "schemes" (append $schemes $scheme) $settings -}}

{{- /* Defaults apply to all profiles, including profiles added by Terminal. */ -}}
{{- $profiles := get $settings "profiles" | default (dict) -}}
{{- $defaults := mergeOverwrite (get $profiles "defaults" | default (dict)) (dict
    "colorScheme" $schemeName
    "useAcrylic" true "opacity" 88
    "unfocusedAppearance" (dict "colorScheme" $schemeName "background" "#11160f"
        "useAcrylic" true "opacity" 88)
    "cursorShape" "filledBox" "scrollbarState" "hidden"
    "font" (dict "face" "JetBrainsMono Nerd Font Mono" "size" 12
        "features" (dict "calt" 1 "clig" 1 "liga" 1))
) -}}
{{- $settings = setValueAtPath "profiles.defaults" $defaults $settings -}}

{{- /* Manage the WSL and PowerShell 7 entries, preserving other profiles. */ -}}
{{- $wsl := dict "guid" $wslGuid "name" "WSL" "commandline" "wsl.exe --cd ~" "hidden" false -}}
{{- $powerShell := dict "guid" $powerShellGuid "name" "PowerShell 7" "commandline" "pwsh.exe -NoLogo" "startingDirectory" "%USERPROFILE%" "hidden" false -}}
{{- $profileList := get $profiles "list" | default (list) -}}
{{- range (list $wsl $powerShell) -}}
    {{- $managed := . -}}
    {{- $updated := list -}}
    {{- $found := false -}}
    {{- range $profileList -}}
        {{- if eq (get . "guid" | default "" | lower) (get $managed "guid") -}}
            {{- $updated = append $updated (mergeOverwrite . $managed) -}}
            {{- $found = true -}}
        {{- else -}}
            {{- $updated = append $updated . -}}
        {{- end -}}
    {{- end -}}
    {{- if not $found -}}{{- $updated = append $updated $managed -}}{{- end -}}
    {{- $profileList = $updated -}}
{{- end -}}
{{- $settings = setValueAtPath "profiles.list" $profileList $settings -}}

{{- /* Focus mode hides tabs; unbind their default creation/navigation shortcuts. */ -}}
{{- $tabKeys := list "ctrl+shift+t" "ctrl+shift+d" "ctrl+shift+space"
    "ctrl+tab" "ctrl+shift+tab"
    "ctrl+shift+1" "ctrl+shift+2" "ctrl+shift+3" "ctrl+shift+4" "ctrl+shift+5"
    "ctrl+shift+6" "ctrl+shift+7" "ctrl+shift+8" "ctrl+shift+9"
    "ctrl+alt+1" "ctrl+alt+2" "ctrl+alt+3" "ctrl+alt+4" "ctrl+alt+5"
    "ctrl+alt+6" "ctrl+alt+7" "ctrl+alt+8" "ctrl+alt+9"
-}}
{{- $keybindings := list -}}
{{- range (get $settings "keybindings" | default (list)) -}}
    {{- if not (has (get . "keys") $tabKeys) -}}
        {{- $keybindings = append $keybindings . -}}
    {{- end -}}
{{- end -}}
{{- range $tabKeys -}}
    {{- $keybindings = append $keybindings (dict "keys" . "id" "unbound") -}}
{{- end -}}
{{- $settings = setValueAtPath "keybindings" $keybindings $settings -}}
{{- $settings = unset $settings "confirmCloseAllTabs" -}}

{{- $settings = $settings
    | setValueAtPath "defaultProfile" $wslGuid
    | setValueAtPath "theme" "dark"
    | setValueAtPath "launchMode" "focus"
    | setValueAtPath "windowingBehavior" "useNew"
    | setValueAtPath (list "warning.confirmCloseAllTabs") false
    | setValueAtPath (list "compatibility.enableUnfocusedAcrylic") true
-}}
{{ $settings | toPrettyJson }}
